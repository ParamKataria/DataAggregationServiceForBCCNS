# Copy this file to scraper/.env and fill in the values.
# The scripts read scraper/.env. Do not commit that file.

# Supabase project URL, used by load_records.py
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key. The loader does not use this. The service-role key below does.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key. Required to load records. Keep this private.
SUPABASE_SECRET_KEY=

# Gemini key for turning a spreadsheet into Dublin Core.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=
